{% extends 'caisse/layout.html.twig' %}

{% block title %}Salaires du personnel — EduManage{% endblock %}
{% block page_title %}Salaires du personnel{% endblock %}

{% block content %}
<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-stack">
            <thead class="table-light">
                <tr>
                    <th>Nom</th>
                    <th>Poste</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for personne in personnel %}
                <tr>
                    <td class="fw-semibold td-title">{{ personne.nomComplet }}</td>
                    <td data-label="Poste">{{ personne.poste ?? '—' }}</td>
                    <td class="text-end">
                        <a href="{{ path('caisse_salaire_historique', {id: personne.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-clock-history"></i>
                        </a>
                        <a href="{{ path('caisse_salaire_nouveau', {id: personne.id}) }}" class="btn btn-sm btn-primary">
                            <i class="bi bi-cash-coin me-1"></i>Nouveau paiement
                        </a>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="3" class="text-center text-muted py-5">Aucun membre du personnel.</td></tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endblock %}
