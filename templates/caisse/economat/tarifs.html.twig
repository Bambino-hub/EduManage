{% extends 'caisse/layout.html.twig' %}

{% block title %}Tarifs par niveau — EduManage{% endblock %}
{% block page_title %}Tarifs de l'écolage {{ anneeActive ? '— ' ~ anneeActive.libelle : '' }}{% endblock %}

{% block content %}
{% if anneeActive is null %}
    <div class="alert alert-warning">Aucune année scolaire active — définissez-en une avant de saisir les tarifs.</div>
{% endif %}

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-stack">
            <thead class="table-light">
                <tr>
                    <th>Niveau</th>
                    <th>Montant annuel</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for niveau in niveaux %}
                {% set tarif = tarifsParNiveauId[niveau.id] ?? null %}
                <tr>
                    <td class="fw-semibold td-title">{{ niveau.nomComplet }}</td>
                    <td data-label="Montant annuel">
                        {% if tarif %}
                            {{ tarif.montantAnnuel|number_format(0, ',', ' ') }} FCFA
                        {% else %}
                            <span class="text-muted">Non défini</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <a href="{{ path('caisse_economat_tarif_editer', {id: niveau.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>{{ tarif ? 'Modifier' : 'Définir' }}
                        </a>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="3" class="text-center text-muted py-5">Aucun niveau.</td></tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endblock %}
