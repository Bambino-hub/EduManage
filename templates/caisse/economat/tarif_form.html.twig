{% extends 'caisse/layout.html.twig' %}

{% block title %}Tarif — {{ niveau.nomComplet }} — EduManage{% endblock %}
{% block page_title %}Tarif — {{ niveau.nomComplet }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-tags-fill me-2 text-college-purple"></i>
                    Tarif — {{ niveau.nomComplet }}
                </h2>
                <a href="{{ path('caisse_economat_tarifs') }}" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Retour
                </a>
            </div>
            <div class="admin-card-body">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.montantAnnuel) }}
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Enregistrer
                    </button>
                    <a href="{{ path('caisse_economat_tarifs') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
