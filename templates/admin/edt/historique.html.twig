{% extends 'admin/layout.html.twig' %}

{% block title %}Historique des emplois du temps — EduManage{% endblock %}
{% block page_title %}Historique des emplois du temps{% endblock %}

{% block admin_content %}
<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="admin-card mb-4">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-clock-history me-2" style="color:var(--college-navy)"></i>
                    Historique
                </h2>
                <a href="{{ path('admin_edt_index') }}" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Retour
                </a>
            </div>
            <div class="admin-card-body">
                {% if annee is null %}
                    <div class="alert alert-danger mb-0">Aucune année scolaire active.</div>
                {% else %}
                    <p class="mb-3">
                        Année active : <strong>{{ annee.libelle }}</strong> —
                        emploi du temps actuel : <strong>{{ nbSeancesNow }}</strong> séance(s).
                    </p>
                    <div class="alert alert-info d-flex gap-2" style="font-size:.85rem">
                        <i class="bi bi-info-circle-fill flex-shrink-0 mt-1"></i>
                        <div>
                            Chaque génération automatique enregistre ici un instantané de l'emploi du temps.
                            Vous pouvez aussi enregistrer l'état actuel à la main avant de faire des retouches.
                            <strong>Restaurer</strong> une version remplace l'emploi du temps actuel par celui de la
                            version choisie (l'état courant est d'abord sauvegardé, vous pouvez donc revenir en arrière).
                            L'historique conserve les <strong>{{ maxVersions }}</strong> entrées les plus récentes.
                        </div>
                    </div>

                    <form method="post" action="{{ path('admin_edt_historique_enregistrer') }}"
                          class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="hidden" name="_token" value="{{ csrf_token('edt_historique') }}">
                        <input type="text" name="libelle" class="form-control form-control-sm" style="max-width:320px"
                               placeholder="Nom de cet enregistrement (facultatif)">
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-bookmark-plus me-1"></i>Enregistrer l'état actuel
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        {% if annee is not null %}
            <div class="admin-card">
                <div class="admin-card-header">
                    <h2 class="admin-card-title">Versions enregistrées</h2>
                </div>
                <div class="admin-card-body">
                    {% if versions is empty %}
                        <div class="alert alert-warning mb-0">
                            Aucune version pour le moment. Lancez une
                            <a href="{{ path('admin_edt_generate') }}">génération automatique</a>
                            ou enregistrez l'état actuel.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                        <table class="table table-sm align-middle table-stack">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Origine</th>
                                    <th class="text-center">Séances</th>
                                    <th class="text-center">Heures</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for v in versions %}
                                    <tr>
                                        <td data-label="Date" class="text-nowrap small">
                                            {{ v.createdAt|date('d/m/Y H:i') }}
                                        </td>
                                        <td data-label="Description">{{ v.libelle }}</td>
                                        <td data-label="Origine">
                                            <span class="badge {{ v.origine.badgeClass }}">{{ v.origine.libelle }}</span>
                                        </td>
                                        <td data-label="Séances" class="text-center">{{ v.nbSeances }}</td>
                                        <td data-label="Heures" class="text-center small">
                                            <span style="color:var(--college-green)">{{ v.heuresPlacees }}h</span>
                                            {% if v.heuresNonPlacees %}
                                                / <span class="text-danger">{{ v.heuresNonPlacees }}h non placées</span>
                                            {% endif %}
                                        </td>
                                        <td data-label="Actions" class="text-end text-nowrap">
                                            <form method="post" action="{{ path('admin_edt_historique_restaurer', {id: v.id}) }}"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Restaurer cette version ? L\'emploi du temps actuel sera remplacé (une sauvegarde de l\'état courant est faite au préalable).');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('edt_historique') }}">
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Restaurer
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('admin_edt_historique_supprimer', {id: v.id}) }}"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Supprimer définitivement cette entrée de l\'historique ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('edt_historique') }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
