{% extends 'admin/layout.html.twig' %}

{% block title %}{{ examenBlanc.id ? 'Modifier' : 'Nouvel' }} examen blanc — EduManage{% endblock %}
{% block page_title %}{{ examenBlanc.id ? 'Modifier' : 'Nouvel' }} examen blanc{% endblock %}

{% block admin_content %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-journal-check me-2 text-college-purple"></i>
                    {{ examenBlanc.id ? 'Modifier l\'examen blanc' : 'Nouvel examen blanc' }}
                </h2>
                <a href="{{ path('admin_examen_blanc_index') }}" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Retour
                </a>
            </div>
            <div class="admin-card-body">
                {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="row g-3">
                    <div class="col-12">{{ form_row(form.libelle) }}</div>
                    <div class="col-6">{{ form_row(form.dateDebut) }}</div>
                    <div class="col-6">{{ form_row(form.dateFin) }}</div>
                </div>

                <div data-controller="examen-blanc-matiere-filter">
                    <div class="mt-3">
                        {{ form_errors(form.niveaux) }}
                        <label class="fw-semibold mb-1">{{ form_label(form.niveaux) }}</label>
                        <p class="text-muted small">{{ form.niveaux.vars.help }}</p>
                        <div class="row g-2">
                            {% for child in form.niveaux %}
                                <div class="col-6 col-md-3">
                                    <div class="form-check">
                                        {{ form_widget(child, {
                                            attr: {
                                                'data-examen-blanc-matiere-filter-target': 'niveau',
                                                'data-action': 'change->examen-blanc-matiere-filter#sync',
                                            },
                                        }) }}
                                        {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="mt-4">
                        {{ form_errors(form.matieres) }}
                        <label class="fw-semibold mb-1">{{ form_label(form.matieres) }}</label>
                        <p class="text-muted small">
                            {{ form.matieres.vars.help }}
                            Seules les matières enseignées dans au moins un des niveaux cochés ci-dessus sont proposées.
                        </p>
                        <p class="text-muted small fst-italic mb-2" data-examen-blanc-matiere-filter-target="empty">
                            Cochez d'abord un niveau pour afficher ses matières.
                        </p>
                        <div class="row g-2">
                            {% for child in form.matieres %}
                                <div class="col-6 col-md-4" data-examen-blanc-matiere-filter-target="matiereRow"
                                     data-niveaux="{{ (matiereNiveauxIds[child.vars.value] ?? [])|json_encode }}">
                                    <div class="form-check">
                                        {{ form_widget(child) }}
                                        {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Enregistrer
                    </button>
                    <a href="{{ path('admin_examen_blanc_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
